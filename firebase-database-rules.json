{
  "rules": {
    ".read": false,
    ".write": false,
    "oddsData": {
      ".read": "auth != null && root.child('config').child('blockedUsers').child(auth.uid).child('blocked').val() != true",
      ".write": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email"
    },
    "config": {
      ".read": "auth != null",
      "adminEmail": {
        ".write": "auth != null && !root.child('config').child('adminEmail').exists()"
      },
      "hiddenTabs": {
        ".write": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email"
      },
      "hiddenBets": {
        ".write": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email"
      },
      "blockedUsers": {
        ".write": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email"
      }
    },
    "userDirectory": {
      ".read": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('config').child('blockedUsers').child(auth.uid).child('blocked').val() != true",
        ".read": "auth != null && (auth.uid === $uid || root.child('config').child('adminEmail').val() == auth.token.email)",
        "email": {
          ".validate": "newData.isString() && newData.val() == auth.token.email"
        }
      }
    },
    "publicStatus": {
      ".read": true,
      ".write": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email"
    },
    "usageLog": {
      ".read": "auth != null && root.child('config').child('adminEmail').val() == auth.token.email",
      "$data": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('config').child('blockedUsers').child(auth.uid).child('blocked').val() != true",
          ".read": "auth != null && (auth.uid === $uid || root.child('config').child('adminEmail').val() == auth.token.email)"
        }
      }
    }
  }
}
